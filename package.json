{
  "name": "remotion-cybersecurity-render",
  "version": "1.0.0",
  "description": "4K 60fps Remotion render pipeline via GitHub Actions",
  "scripts": {
    "start": "npx remotion studio",
    "render": "npx remotion render CybersecurityNetworkMap output/out.mp4 --width=3840 --height=2160 --fps=60 --frames=0-899 --codec=h264 --crf=18",
    "preview": "npx remotion render CybersecurityNetworkMap output/preview.mp4 --width=1920 --height=1080 --fps=30 --frames=0-899 --codec=h264"
  },
  "dependencies": {
    "@remotion/cli": "4.0.237",
    "remotion": "4.0.237",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "typescript": "5.4.5"
  },
  "remotion": {
    "entryPoint": "src/index.ts"
  }
}
